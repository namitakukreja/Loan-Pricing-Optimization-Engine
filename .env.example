# Server
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# LLM configuration (used by the explanation layer only).
# The LLM is used ONLY to explain the decision, never to calculate it.
# If LLM_TOKEN is not set (or the call fails), a deterministic fallback
# explanation is returned so the API still responds with a valid result.
# (Secure rule: use environment variables for secrets, never hardcode them.)
# ---------------------------------------------------------------------------
# Bearer token for the external LLM wrapper — leave blank to use the fallback.
LLM_TOKEN=
# Endpoint (defaults to the provided wrapper; override if needed).
# LLM_ENDPOINT=https://llm-wrapper-741152993481.asia-south1.run.app/llm/query
# Hard timeout per LLM call (ms).
LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# OPTIONAL alternative explanation layer (provider-based: OpenAI / Claude).
# NOT used by the active flow (which uses the LLM wrapper above). Kept as a
# pluggable option in src/ai/. Configure these only if you switch to it.
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai            # "openai" or "claude" (alias "anthropic")
# AI_MODEL=gpt-4o-mini          # defaults per provider
# AI_API_KEY=                   # provider secret (empty => fallback)
# AI_BASE_URL=                  # override for proxy/gateway (HTTPS only)
# AI_TIMEOUT_MS=8000
# AI_MAX_TOKENS=300
# AI_TEMPERATURE=0.3
